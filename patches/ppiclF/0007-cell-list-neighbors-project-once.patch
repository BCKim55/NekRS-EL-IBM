 !-----------------------------------------------------------------------
+      integer*8 function ppiclf_solve_CellKey(nb)
+!
+      implicit none
+!
+      include "PPICLF"
+!
+      integer*4 nb(3)
+!
+      ppiclf_solve_CellKey = (int(nb(1),8)+32)*ppiclf_cl_stride(1)
+     >                     + (int(nb(2),8)+32)*ppiclf_cl_stride(2)
+     >                     + (int(nb(3),8)+32)*ppiclf_cl_stride(3)
+      return
+      end
+!-----------------------------------------------------------------------
+      subroutine ppiclf_solve_CellSort(n,key,idx)
+!
+! heap sort of key(1:n) with idx permuted alongside
+!
+      implicit none
+!
+      integer*4 n, idx(*)
+      integer*8 key(*)
+      integer*4 i, j, k, it
+      integer*8 kt
+!
+      if (n .lt. 2) return
+      do i=n/2,1,-1
+         call ppiclf_solve_CellSift(key,idx,i,n)
+      enddo
+      do i=n,2,-1
+         kt = key(1)
+         key(1) = key(i)
+         key(i) = kt
+         it = idx(1)
+         idx(1) = idx(i)
+         idx(i) = it
+         call ppiclf_solve_CellSift(key,idx,1,i-1)
+      enddo
+      return
+      end
+!-----------------------------------------------------------------------
+      subroutine ppiclf_solve_CellSift(key,idx,istart,iend)
+!
+      implicit none
+!
+      integer*4 idx(*), istart, iend
+      integer*8 key(*)
+      integer*4 iroot, ichild, it
+      integer*8 kt
+!
+      iroot = istart
+      do while (2*iroot .le. iend)
+         ichild = 2*iroot
+         if (ichild .lt. iend) then
+            if (key(ichild+1) .gt. key(ichild)) ichild = ichild + 1
+         endif
+         if (key(iroot) .ge. key(ichild)) return
+         kt = key(iroot)
+         key(iroot) = key(ichild)
+         key(ichild) = kt
+         it = idx(iroot)
+         idx(iroot) = idx(ichild)
+         idx(ichild) = it
+         iroot = ichild
+      enddo
+      return
+      end
+!-----------------------------------------------------------------------
+      subroutine ppiclf_solve_CellRange(n,key,k,i1,i2)
+!
+! first and last position of key k in sorted key(1:n) (i1 > i2: none)
+!
+      implicit none
+!
+      integer*4 n, i1, i2
+      integer*8 key(*), k
+      integer*4 lo, hi, mid
+!
+      lo = 1
+      hi = n + 1
+      do while (lo .lt. hi)
+         mid = (lo + hi)/2
+         if (key(mid) .lt. k) then
+            lo = mid + 1
+         else
+            hi = mid
+         endif
+      enddo
+      i1 = lo
+      hi = n + 1
+      do while (lo .lt. hi)
+         mid = (lo + hi)/2
+         if (key(mid) .le. k) then
+            lo = mid + 1
+         else
+            hi = mid
+         endif
+      enddo
+      i2 = lo - 1
+      return
+      end
