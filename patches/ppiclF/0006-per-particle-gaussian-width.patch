+#else
+      subroutine ppiclf_solve_InitParticleFilter(jfilt)
+#endif
+!
+! Per-particle Gaussian width: rprop(jfilt,i) > 0 is that particle's FWHM
+! for the projection (0 or jfilt = 0: the global filter). The global width
+! set by InitGaussianFilter must be the largest one used, as it sets the
+! ghost and truncation distances.
+!
+      implicit none
+!
+      include "PPICLF"
+!
+      integer*4 jfilt
+!
+      if (.not.PPICLF_LFILTGAUSS)
+     >call ppiclf_exittr('InitGaussianFilter must be before '//
+     >                   'InitParticleFilter$',0.0d0,0)
+      if (jfilt .lt. 0 .or. jfilt .gt. PPICLF_LRP)
+     >call ppiclf_exittr('Invalid rprop slot for InitParticleFilter$'
+     >                  ,0.0d0,jfilt)
+
+      ppiclf_jfilt = jfilt
+
+      return
+      end
