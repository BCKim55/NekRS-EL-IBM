// Pilobolus sporangium launch WITH SAP (Pilobolus step 5): the single-phase
// case (../launch.udf) plus EL sap droplets injected at the nozzle (main
// drops d_main and satellites d_sat, jet speed v_jet (0: the body's speed at
// the moment of emission, so the sap neither catches the cap nor lags it), for t < t_inj, total
// volume sap_volume) that stick to the sporangium on contact
// (attach = 1, Config::attachOnContact) and then ride on it, adding their
// mass, or bounce and hold liquid bridges (attach = 0, bridge_*). The EL
// projection uses filter_width (a few droplet spacings), the IBM markers
// filter_width_ibm. Extra report columns: droplets in the domain, stuck
// count and mass, sap momentum. snapshot_interval > 0: EL/body snapshots
// for ParaView (src/elSnapshot.hpp, scripts/paraview_el_movie.py).
// Injection is a non-overlapping train: a main drop every V_main / Q_main,
// satellites only in the gap behind it (never while a main drop is at the
// nozzle), each placed at a random point of the nozzle disc and of the
// step's travel that clears every drop now within 2 d_main of the nozzle,
// including ones thrown back (deferred otherwise). Overlapping drops would
// be thrown apart by the contact spring.
//
// Base case: an IBM
// sphere (equivalent sporangium, d = 0.35 mm) driven along +x through air at
// rest by the measured velocity history v(t) (Yafetto et al. 2008: rest ->
// v_max in t_rise, then a deceleration `decel`), from x_start in front of
// the nozzle at the origin. Far field u = 0, outflow at x+.
//
// free_flight = 0: prescribed for the whole run. Reported every
//   report_interval steps ("launch:"): x, v, a of the body, the marker force
//   sum F_m (fluid force on body + internal fluid), the force on the body
//   proper F = F_m + rho_f V a, C_d = -F_x / (rho_f v^2 pi d^2 / 8), and the
//   deceleration that force alone would give the body, a_f = F_x / (rho_b V);
//   F_c, the contact force of the sap parcels on the body (spring-dashpot,
//   liquid bridges and the impulse of parcels that stick), its bridge part
//   F_br, a_c = F_c / (rho_b V) and a_tot = a_f + a_c. a_tot is what the
//   measured deceleration (~1500 m/s2) has to be compared with; with a
//   prescribed body it is the force the measured v(t) needs to tow the sap.
// free_flight = 1: prescribed until t_rise, then a free body under the
//   fluid force and gravity: the deceleration of a dry sporangium.
// trajectory = "file.csv" (t_us, speed): v(t) from the smoothed measurement
//   instead of the analytic profile.

#include <algorithm>
#include <array>
#include <random>
#include <fstream>
#include <sstream>

#include "elSnapshot.hpp"
#include "elibm.hpp"
#include "fieldDump.hpp"

static double diameter, bodyRho, vMax, tRise, decel, xStart, markerSpacing, filterWidth;
static int hemisphere = 0; // 1: sporangium as a solid hemisphere, dome forward, flat face trailing
static double hemisphereRadius = 0; // > 0: its radius; 0: the radius of the same volume as the sphere of `diameter`
static double restitution = 0.9, sigma = 0.072, contactAngleDeg = 0, bridgeVolumeFraction = 0.1;
static int bridgeEl = 0, bridgeIbm = 0;
static int freeFlight, reportInterval;
static std::string trajectoryFile;
static std::vector<double> trajT, trajV, trajX; // measured profile (SI)
static elibm::Coupling *coupling = nullptr;     // never deleted (MPI resources)
static double vPrev = 0;
static double filterWidthIbm, sapVolume, dMain, dSat, satFraction, vJet, vSpread, tInj, nozzleRadius, rhoSap, kn;
static int attach, substeps, snapshotInterval = 0;
static double carryMain = 0, carrySat = 0, injectedVolume = 0, tLastMain = -1;
static int jetMode = 0; // 1: dense stream of small parcels: touching allowed, no overlap, placed in a disc of inject_radius
static double injectRadius = 0;
static double phiMax = 0; // > 0: cap on the projected phi_p (phi_max; 0: none)
static std::mt19937_64 rng(2026);

#ifdef __okl__

void udfDirichlet(bcData *bc)
{
  if (isField("fluid velocity")) {
    bc->uxFluid = 0.0;
    bc->uyFluid = 0.0;
    bc->uzFluid = 0.0;
  }
  if (isField("fluid pressure")) {
    // outflow: dynamic-pressure stabilisation against backflow
    const dfloat iU0delta = 10.0;
    const dfloat un = bc->uxFluid * bc->nx + bc->uyFluid * bc->ny + bc->uzFluid * bc->nz;
    const dfloat s0 = 0.5 * (1.0 - tanh(un * iU0delta));
    bc->pFluid = -0.5 * (bc->uxFluid * bc->uxFluid + bc->uyFluid * bc->uyFluid + bc->uzFluid * bc->uzFluid) * s0;
  }
}

#endif

// analytic profile: half-cosine rise to v_max, then linear deceleration
static void profile(double t, double &x, double &v, double &a)
{
  if (!trajT.empty()) {
    // measured: piecewise-linear v, x by its integral, a by the slope
    size_t i = 1;
    while (i < trajT.size() - 1 && trajT[i] < t) {
      i++;
    }
    const double w = (t - trajT[i - 1]) / (trajT[i] - trajT[i - 1]);
    a = (trajV[i] - trajV[i - 1]) / (trajT[i] - trajT[i - 1]);
    v = trajV[i - 1] + w * (trajV[i] - trajV[i - 1]);
    x = trajX[i - 1] + (t - trajT[i - 1]) * 0.5 * (trajV[i - 1] + v);
    if (t > trajT.back()) {
      v = trajV.back();
      a = 0;
      x = trajX.back() + (t - trajT.back()) * v;
    }
    return;
  }
  if (t < tRise) {
    const double s = M_PI * t / tRise;
    v = 0.5 * vMax * (1 - std::cos(s));
    a = 0.5 * vMax * M_PI / tRise * std::sin(s);
    x = 0.5 * vMax * (t - tRise / M_PI * std::sin(s));
  } else {
    const double tau = t - tRise;
    v = std::max(0.0, vMax - decel * tau);
    a = v > 0 ? -decel : 0.0;
    const double tauStop = vMax / decel;
    const double te = std::min(tau, tauStop);
    x = 0.5 * vMax * tRise + vMax * te - 0.5 * decel * te * te;
  }
}

void UDF_Setup0(MPI_Comm comm, setupAide &options)
{
  auto get = [](const char *key, auto &v) { platform->par->extract("casedata", key, v); };
  get("diameter", diameter);
  get("hemisphere", hemisphere);
  get("hemisphere_radius", hemisphereRadius);
  get("body_rho", bodyRho);
  get("v_max", vMax);
  get("t_rise", tRise);
  get("decel", decel);
  get("x_start", xStart);
  get("free_flight", freeFlight);
  get("trajectory", trajectoryFile);
  get("marker_spacing", markerSpacing);
  get("filter_width", filterWidth);
  get("phi_max", phiMax);
  get("report_interval", reportInterval);
  get("snapshot_interval", snapshotInterval);
  get("filter_width_ibm", filterWidthIbm);
  get("sap_volume", sapVolume);
  get("d_main", dMain);
  get("d_sat", dSat);
  get("sat_fraction", satFraction);
  get("jet_mode", jetMode);
  get("inject_radius", injectRadius);
  get("v_jet", vJet);
  get("v_spread", vSpread);
  get("t_inj", tInj);
  get("nozzle_radius", nozzleRadius);
  get("rho_sap", rhoSap);
  get("attach", attach);
  get("kn", kn);
  get("substeps", substeps);
  get("restitution", restitution);
  get("bridge_el", bridgeEl);
  get("bridge_ibm", bridgeIbm);
  get("sigma", sigma);
  get("contact_angle_deg", contactAngleDeg);
  get("bridge_volume_fraction", bridgeVolumeFraction);

  if (!trajectoryFile.empty()) {
    std::ifstream f(trajectoryFile);
    nekrsCheck(!f.good(), comm, EXIT_FAILURE, "cannot read trajectory %s\n", trajectoryFile.c_str());
    std::string line;
    std::getline(f, line); // header: t_us,speed
    double x = 0;
    while (std::getline(f, line)) {
      std::replace(line.begin(), line.end(), ',', ' ');
      std::istringstream ss(line);
      double tus, v;
      if (!(ss >> tus >> v)) {
        continue;
      }
      if (!trajT.empty()) {
        x += 0.5 * (v + trajV.back()) * (tus * 1e-6 - trajT.back());
      }
      trajT.push_back(tus * 1e-6);
      trajV.push_back(v);
      trajX.push_back(x);
    }
    nekrsCheck(trajT.size() < 2, comm, EXIT_FAILURE, "trajectory %s has fewer than 2 rows\n", trajectoryFile.c_str());
  }
}

void UDF_Setup()
{
  elibm::Config cfg;
  platform->options.getArgs("FLUID DENSITY", cfg.rhof);
  platform->options.getArgs("FLUID VISCOSITY", cfg.mu);
  cfg.periodic = {false, false, false};
  cfg.grav = {0.0, -9.81, 0.0};
  cfg.filterWidth = filterWidth;
  cfg.phiMax = phiMax;
  cfg.filterWidthIbm = filterWidthIbm;
  cfg.markerSpacing = markerSpacing;
  cfg.qtl = false;
  cfg.zeroMeanDiv = false;
  cfg.kn = kn;
  cfg.restitution = restitution; // irrelevant with attachment
  cfg.substeps = substeps;
  cfg.attachOnContact = attach != 0;
  cfg.bridgeEl = bridgeEl != 0;
  cfg.bridgeIbm = bridgeIbm != 0;
  cfg.sigma = sigma;
  cfg.contactAngle = contactAngleDeg * M_PI / 180;
  cfg.bridgeVolumeFraction = bridgeVolumeFraction;
  // EL-EL search radius: contact of the main drops, plus the bridge reach
  cfg.neighborWidth = dMain + (bridgeEl ? cfg.bridgeRupture(dMain) : 0);
  coupling = new elibm::Coupling(nrs, cfg);

  elibm::Body body;
  body.radius = !hemisphere ? 0.5 * diameter : hemisphereRadius > 0 ? hemisphereRadius : 0.5 * diameter * std::cbrt(2.0);
  body.hemisphere = hemisphere != 0;
  if (body.hemisphere) {
    body.setAxis({1, 0, 0}); // dome towards +x (flight direction), flat face towards the nozzle
  }
  body.rho = bodyRho;
  body.prescribed = true;
  double x, v, a;
  profile(0.0, x, v, a);
  body.x = {xStart + x, 0.0, 0.0};
  body.v = {v, 0.0, 0.0};
  vPrev = v;
  coupling->addBody(body);
  coupling->initialize();
  const auto tot = coupling->totals(); // collective
  if (platform->comm.mpiRank() == 0) {
    printf("launch: d %.3e  rho_b/rho_f %.1f  v_max %.2f (Re %.0f)  t_rise %.2e  decel %.0f  markers %lld  mode %s%s\n", diameter,
           bodyRho / cfg.rhof, vMax, vMax * diameter * cfg.rhof / cfg.mu, tRise, decel, tot.nMarker,
           freeFlight ? "free flight after t_rise" : "prescribed", trajT.empty() ? "" : " (measured v(t))");
    if (hemisphere) {
      printf("launch: hemisphere R %.3e (width %.3e, mass %.3e kg vs sphere %.3e)\n", body.radius, 2 * body.radius,
             bodyRho * body.volume(), bodyRho * M_PI / 6 * diameter * diameter * diameter);
    }
    if (bridgeEl || bridgeIbm) {
      const double r = 0.5 * dMain, Rb = body.radius, c = std::cos(cfg.contactAngle);
      printf("launch: liquid bridge EL %d IBM %d  sigma %.3e  theta %.0f deg  V_b/V_p %.2f  rupture gap %.3e (%.2f d_main)"
             "  F_max EL-EL %.3e N  EL-IBM %.3e N  (main drop weight %.3e N)\n",
             bridgeEl, bridgeIbm, sigma, contactAngleDeg, bridgeVolumeFraction, cfg.bridgeRupture(dMain), cfg.bridgeRupture(dMain) / dMain,
             2 * M_PI * sigma * r * c, 2 * M_PI * sigma * (2 * r * Rb / (r + Rb)) * c, rhoSap * M_PI / 6 * dMain * dMain * dMain * 9.81);
    }
  }
}

void UDF_ExecuteStep(double time, int tstep)
{
  auto &body = coupling->bodies()[0];
  const double dt = nrs->dt[0];
  double x, v, a;
  profile(time, x, v, a);
  if (body.prescribed) {
    body.x = {xStart + x, 0.0, 0.0};
    body.v = {v, 0.0, 0.0};
    if (freeFlight && time >= tRise) {
      body.prescribed = false; // released with the velocity reached
    }
  } else {
    a = (body.v[0] - vPrev) / dt; // free flight: measured from the body
  }
  vPrev = body.v[0];

  // sap injection at the nozzle (rank 0 creates, collective call)
  std::vector<elibm::ElParticle> list;
  const bool injecting = tstep > 0 && time <= tInj + 0.5 * dt;
  const auto all = injecting ? elibm::gatherElRows() : std::vector<double>{}; // collective
  if (injecting && platform->comm.mpiRank() == 0) {
    const double volStep = sapVolume * dt / tInj;
    const double vMainDrop = M_PI / 6 * dMain * dMain * dMain;
    const double tMain = vMainDrop / (sapVolume * (1 - satFraction) / tInj); // main-drop period
    carryMain += volStep * (1 - satFraction) / vMainDrop;
    carrySat += volStep * satFraction / (M_PI / 6 * dSat * dSat * dSat);
    std::uniform_real_distribution<double> uni(0.0, 1.0);
    std::normal_distribution<double> gauss(0.0, 1.0);
    const double x0 = 1e-6; // nozzle plane
    const double vj = vJet > 0 ? vJet : std::max(body.v[0], 1e-3); // v_jet 0: emitted at the cap's speed
    // drops now within 2 d_main of the nozzle (gathered above), plus this step's: (x, y, z, d)
    std::vector<std::array<double, 4>> near;
    for (size_t i = 0; i + elibm::kElCols <= all.size(); i += elibm::kElCols) {
      if (all[i + 1] < x0 + 2 * dMain) {
        near.push_back({all[i + 1], all[i + 2], all[i + 3], all[i + 8]});
      }
    }
    auto emit = [&](double d, double &carry, int tries) {
      while (carry >= 1) {
        elibm::ElParticle p;
        std::array<double, 4> q{};
        bool ok = false;
        for (int k = 0; k < tries && !ok; ++k) {
          const double rMax = (jetMode && injectRadius > 0 ? injectRadius : nozzleRadius) - 0.5 * d;
          const double r = (rMax > 0 ? rMax : 0) * std::sqrt(uni(rng)), th = 2 * M_PI * uni(rng);
          q = {x0 + vj * uni(rng) * dt, r * std::cos(th), r * std::sin(th), d}; // emitted during this step
          ok = true;
          for (const auto &o : near) { // clearance: radii (+ one step of jet travel for a drop train)
            const double dx = o[0] - q[0], dy = o[1] - q[1], dz = o[2] - q[2];
            if (std::sqrt(dx * dx + dy * dy + dz * dz) < 0.5 * (o[3] + d) + (jetMode ? 0 : vj * dt)) {
              ok = false;
              break;
            }
          }
        }
        if (!ok) {
          break; // no free slot this step: keep the carry
        }
        carry -= 1;
        near.push_back(q);
        p.x = {q[0], q[1], q[2]};
        p.v = {vj, vSpread * gauss(rng), vSpread * gauss(rng)};
        p.dp = d;
        p.rho = rhoSap;
        list.push_back(p);
        injectedVolume += M_PI / 6 * d * d * d;
        if (d == dMain) {
          tLastMain = time - (q[0] - x0) / vj;
        }
      }
    };
    emit(dMain, carryMain, jetMode ? 60 : 20);
    // satellites only in the gap: the last main drop has cleared the nozzle and the next is not due yet
    const double clear = 1.1 * 0.5 * (dMain + dSat) / vj;
    if (time - tLastMain >= clear && (1 - carryMain) * tMain >= clear) {
      emit(dSat, carrySat, 50);
    }
  }
  if (tstep > 0) {
    coupling->inject(list);
  }
  coupling->step(time, tstep);

  if (tstep > 0 && (tstep % reportInterval == 0 || nrs->lastStep)) {
    const auto fm = coupling->hydroForceOnBodies()[0];
    // contact force of the sap on the body (spring-dashpot + bridges + stuck parcels) and its bridge part
    const auto fcn = coupling->contactForceOnBodies()[0], fbr = coupling->bridgeForceOnBodies()[0];
    const double rhof = 1.2, V = body.volume();
    const double ax = body.prescribed ? a : (body.v[0] - vPrev) / dt;
    const double fx = fm[0] + rhof * V * ax; // force on the body proper
    const double u = std::max(std::abs(body.v[0]), 1e-12);
    const double dRef = 2 * body.radius; // frontal diameter (hemisphere: its width)
    const double cd = -fx / (0.5 * rhof * u * u * M_PI * dRef * dRef / 4.0) * (body.v[0] < 0 ? -1 : 1);
    const auto tot = coupling->totals(); // collective
    const auto ext = coupling->sourceExtrema(); // collective
    if (platform->comm.mpiRank() == 0) {
      printf("launch: step %d  t %.4e  x %.4e  v %.4f  a %.4e  Fm %.4e %.4e %.4e  F %.4e  Cd %.4f  a_f %.4e  slip %.3e"
             "  drops %lld  stuck %lld  m_stuck %.3e  P_sap %.4e  Fc %.4e  Fbr %.4e  a_c %.4e  a_tot %.4e  phi_max %.3e  FU_max %.3e  div_max %.3e%s\n",
             tstep, time, body.x[0], body.v[0], ax, fm[0], fm[1], fm[2], fx, cd, fx / (bodyRho * V), coupling->slipRms(),
             tot.nEl, tot.nAttached, tot.attachedMass, tot.elMomentum[0], fcn[0], fbr[0], fcn[0] / (bodyRho * V),
             (fx + fcn[0]) / (bodyRho * V), ext[0], ext[1], ext[2], body.prescribed ? "" : "  free");
      if (nrs->lastStep) {
        printf("launch: injected %.4e m3 of %.4e (main carry %.2f, satellite carry %.2f deferred)\n", injectedVolume, sapVolume, carryMain, carrySat);
      }
    }
  }
  if (snapshotInterval > 0 && (tstep % snapshotInterval == 0 || nrs->lastStep)) {
    elibm::writeSnapshot(*coupling, time, tstep);
  }
  if (nrs->lastStep) {
    dumpPlane(nrs, "plane_z0.csv", 2, 0.0, 1e-12);
  }
}
