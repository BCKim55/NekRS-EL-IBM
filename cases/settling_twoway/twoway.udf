// Two-way coupled settling of EL point particles in a fully periodic box
// (src/elibm.hpp with no IBM bodies).
//
// Checks (z, the gravity direction), each normalised by the gravity impulse
// sum(m_p) |g| t unless noted:
//   proj  : int F_proj dV - sum f_p, normalised by |sum f_p| instead
//           -> projection conservation (Gaussian truncation + quadrature)
//   fluid : P_f - P_f0 - int_0^t int FU dV dt
//           -> the fluid receives the source it is given
//   total : P_f + P_p - P_0 - sum(m_p) g t
//           -> global momentum; periodic walls leave gravity on the particles
//              as the only external force, so this is nonzero only through
//              1/(1 - phi_p) and the explicit lag between the two updates
//   div   : RMS of the imposed div u = -(1/phi_f) D phi_f/Dt (qtl = 1), and
//           of the difference between it and the solved div u

#include <random>

#include "elibm.hpp"

static int nPartGlobal;
static int reportInterval;
static int ppiclfIOStep;
static int qtl;
static double rhop, dp, gz, filterWidth;

static std::unique_ptr<elibm::Coupling> coupling;
static double sourceZ = 0;        // int FU_z dV of the source in use
static double sourceImpulse = 0;  // int_0^t int FU_z dV dt

#ifdef __okl__

#endif

static void report(double time, int tstep)
{
  const auto tot = coupling->totals();
  const double impulse = tot.elMass * std::abs(gz) * time;
  const double fz = tot.elForceOnFluid[2];
  if (platform->comm.mpiRank() == 0) {
    const double inv = impulse > 0 ? 1 / impulse : 0;
    printf("twoway: step %d  t %.4e  Pf %.6e  Pp %.6e  sumf %.6e  "
           "proj %.3e  fluid %.3e  total %.3e  div %.3e  divErr %.3e\n",
           tstep,
           time,
           tot.fluidMomentum[2],
           tot.elMomentum[2],
           fz,
           fz != 0 ? (tot.elForceProjected[2] - fz) / std::abs(fz) : 0.0,
           (tot.fluidMomentum[2] - sourceImpulse) * inv,
           (tot.fluidMomentum[2] + tot.elMomentum[2] - tot.elMass * gz * time) * inv,
           tot.divRms,
           tot.divErrRms);
  }
}

void UDF_Setup0(MPI_Comm comm, setupAide &options)
{
  platform->par->extract("casedata", "nparticles", nPartGlobal);
  platform->par->extract("casedata", "rhop", rhop);
  platform->par->extract("casedata", "dp", dp);
  platform->par->extract("casedata", "gz", gz);
  platform->par->extract("casedata", "filter_width", filterWidth);
  platform->par->extract("casedata", "report_interval", reportInterval);
  platform->par->extract("casedata", "qtl", qtl);
  platform->par->extract("casedata", "ppiclf_iostep", ppiclfIOStep);
}

void UDF_Setup()
{
  elibm::Config cfg;
  platform->options.getArgs("FLUID DENSITY", cfg.rhof);
  platform->options.getArgs("FLUID VISCOSITY", cfg.mu);
  cfg.grav = {0, 0, gz};
  cfg.periodic = {true, true, true};
  cfg.filterWidth = filterWidth;
  cfg.ioStep = ppiclfIOStep;
  cfg.qtl = qtl != 0;

  coupling = std::make_unique<elibm::Coupling>(nrs, cfg);
  const auto lo = coupling->domainLo();
  const auto hi = coupling->domainHi();

  // particles at rest, uniformly random in the box, all created on rank 0
  if (platform->comm.mpiRank() == 0) {
    std::mt19937_64 gen(12345);
    std::uniform_real_distribution<double> uni(0.0, 1.0);
    for (int i = 0; i < nPartGlobal; i++) {
      elibm::ElParticle p;
      for (int k = 0; k < 3; k++) {
        p.x[k] = lo[k] + uni(gen) * (hi[k] - lo[k]);
      }
      p.dp = dp;
      p.rho = rhop;
      coupling->addEl(p);
    }
  }
  coupling->initialize();
}

void UDF_ExecuteStep(double time, int tstep)
{
  if (tstep > 0) {
    // the source applied during the step that just finished
    sourceImpulse += nrs->dt[0] * sourceZ;
  }
  coupling->step(time, tstep);
  sourceZ = coupling->totals().source[2];

  if (tstep % reportInterval == 0 || nrs->lastStep) {
    report(time, tstep);
  }
}
