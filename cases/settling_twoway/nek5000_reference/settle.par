[GENERAL]
stopAt = numSteps
numSteps = 200
dt = 1e-3
timeStepper = bdf2
extrapolation = standard
variableDt = no
writeControl = timeStep
writeInterval = 1000

[PROBLEMTYPE]
equation = incompNS

[PRESSURE]
residualTol = 1e-8
residualProj = no

[VELOCITY]
residualTol = 1e-12
density = 1.0
viscosity = 0.01
