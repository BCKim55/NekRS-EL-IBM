#include "PPICLF_USER.h"
#include "PPICLF_STD.h"
c-----------------------------------------------------------------------
c settling_twoway on the ORIGINAL ppiclF + Nek5000: 10 000 particles,
c rho_p = 100, d_p = 0.01, at rest in a fully periodic unit box, gravity
c g = -1 in z, two-way coupled through ppiclF's Gaussian projection; the
c momentum source is F / (1 - phi_p) / rho as in ppiclF's Nek5000 example.
c Prints the same budget line as cases/settling_twoway (P_f, P_p, sum f).
c-----------------------------------------------------------------------
      subroutine uservp (ix,iy,iz,eg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      udiff  = 0.0
      utrans = 0.0
      return
      end
c-----------------------------------------------------------------------
      subroutine userf  (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      ie = gllel(ieg)
      call ppiclf_solve_GetProFldIJKEF(ix,iy,iz,ie,PPICLF_P_JFX,ffx)
      call ppiclf_solve_GetProFldIJKEF(ix,iy,iz,ie,PPICLF_P_JFY,ffy)
      call ppiclf_solve_GetProFldIJKEF(ix,iy,iz,ie,PPICLF_P_JFZ,ffz)
      call ppiclf_solve_GetProFldIJKEF(ix,iy,iz,ie,PPICLF_P_JPHIP,rphip)
      rdum = 1.0/vtrans(ix,iy,iz,ie,1)/(1.0-rphip)
      ffx = ffx*rdum
      ffy = ffy*rdum
      ffz = ffz*rdum
      return
      end
c-----------------------------------------------------------------------
      subroutine userq  (ix,iy,iz,eg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      qvol = 0.0
      return
      end
c-----------------------------------------------------------------------
      subroutine userchk
      include 'SIZE'
      include 'TOTAL'
      real*8 pf, pp, sf, rm, rmtot
      ntot = lx1*ly1*lz1*nelv

      ! interpolate the fluid velocity to the particles and integrate them
      call ppiclf_solve_InterpFieldUser(PPICLF_R_JUX,vx(1,1,1,1))
      call ppiclf_solve_InterpFieldUser(PPICLF_R_JUY,vy(1,1,1,1))
      call ppiclf_solve_InterpFieldUser(PPICLF_R_JUZ,vz(1,1,1,1))
      call ppiclf_solve_IntegrateParticle(istep,100000,dt,time)

      if (mod(istep,20).eq.0) then
         pf = glsc2(vz,bm1,ntot)       ! rho_f = 1
         call ppiclf_user_budget(pp,sf,rm)
         pp = glsum(pp,1)
         sf = glsum(sf,1)
         rmtot = glsum(rm,1)
         if (nid.eq.0) write(6,1) istep, time, pf, pp, sf,
     >      (pf+pp+rmtot*time)/(rmtot*time+1e-30)
    1    format('twoway: step ',i6,'  t ',1pe12.4,'  Pf ',1pe13.6,
     >          '  Pp ',1pe13.6,'  sumf ',1pe13.6,'  total ',1pe10.3)
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine userbc (ix,iy,iz,iside,eg)
      include 'SIZE'
      include 'TSTEP'
      include 'NEKUSE'
      ux = 0.0
      uy = 0.0
      uz = 0.0
      return
      end
c-----------------------------------------------------------------------
      subroutine useric (ix,iy,iz,eg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      ux = 0.0
      uy = 0.0
      uz = 0.0
      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat
      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat2
      include 'SIZE'
      include 'TOTAL'
      common /nekmpi/ mid,mp,nekcomm,nekgroup,nekreal
      real*8 y(PPICLF_LRS, PPICLF_LPART)
      real*8 rprop(PPICLF_LRP, PPICLF_LPART)
      real*8 dp, rhop, ran2
      external ran2
      integer*4 imethod, iendian, npart, i

      call ppiclf_comm_InitMPI(nekcomm, nid, np)

      ! the same population as settling_twoway (positions from a different
      ! random stream): 10 000 particles at rest, uniform in [0,1]^3, rank 0
      dp   = 0.01d0
      rhop = 100.0d0
      npart = 0
      if (nid .eq. 0) then
         rdum = ran2(-12345)
         npart = 10000
         do i=1,npart
            y(PPICLF_JX,i)  = ran2(2)
            y(PPICLF_JY,i)  = ran2(2)
            y(PPICLF_JZ,i)  = ran2(2)
            y(PPICLF_JVX,i) = 0.0d0
            y(PPICLF_JVY,i) = 0.0d0
            y(PPICLF_JVZ,i) = 0.0d0
            rprop(PPICLF_R_JRHOP,i) = rhop
            rprop(PPICLF_R_JDP  ,i) = dp
            rprop(PPICLF_R_JVOLP,i) = pi/6.0d0*dp**3
            rprop(PPICLF_R_JID  ,i) = i-1
         enddo
      endif
      imethod = 1
      iendian = 0
      call ppiclf_solve_InitParticle(imethod,ndim,iendian,npart,
     >                               y(1,1),rprop(1,1))
      ! same Gaussian filter as settling_twoway: FWHM 0.15, cut at 1e-4
      call ppiclf_solve_InitGaussianFilter(0.15d0,1.0d-4,0)
      call ppiclf_comm_InitOverlapMesh(nelt,lx1,ly1,lz1,xm1,ym1,zm1)
      call ppiclf_solve_InitPeriodicX(0.0d0,1.0d0)
      call ppiclf_solve_InitPeriodicY(0.0d0,1.0d0)
      call ppiclf_solve_InitPeriodicZ(0.0d0,1.0d0)
      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat3
      return
      end
c-----------------------------------------------------------------------
      real*8 FUNCTION ran2(idum)
      INTEGER*4 idum,IM1,IM2,IMM1,IA1,IA2,IQ1,IQ2,IR1,IR2,NTAB,NDIV
      REAL*8 AM,EPS,RNMX
      PARAMETER (IM1=2147483563,IM2=2147483399,AM=1./IM1,IMM1=IM1-1,
     $        IA1=40014,IA2=40692,IQ1=53668,IQ2=52774,IR1=12211,
     $        IR2=3791,NTAB=32,NDIV=1+IMM1/NTAB,EPS=1.2e-7,RNMX=1.-EPS)
      INTEGER*4 idum2,j,k,iv(NTAB),iy,idum1
      SAVE iv,iy,idum2,idum1
      DATA idum2/123456789/, iv/NTAB*0/, iy/0/
      if (idum.le.0) then
         idum1=max(-idum,1)
         idum2=idum1
         do j=NTAB+8,1,-1
            k=idum1/IQ1
            idum1=IA1*(idum1-k*IQ1)-k*IR1
            if (idum1.lt.0) idum1=idum1+IM1
            if (j.le.NTAB) iv(j)=idum1
         enddo
         iy=iv(1)
      endif
      k=idum1/IQ1
      idum1=IA1*(idum1-k*IQ1)-k*IR1
      if (idum1.lt.0) idum1=idum1+IM1
      k=idum2/IQ2
      idum2=IA2*(idum2-k*IQ2)-k*IR2
      if (idum2.lt.0) idum2=idum2+IM2
      j=1+iy/NDIV
      iy=iv(j)-idum2
      iv(j)=idum1
      if(iy.lt.1)iy=iy+IMM1
      ran2=min(AM*iy,RNMX)
      return
      END
c-----------------------------------------------------------------------
