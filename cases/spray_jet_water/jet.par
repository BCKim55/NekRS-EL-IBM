userSections = CASEDATA

[GENERAL]
polynomialOrder = 5
stopAt = numSteps
numSteps = 10000
dt = 2.5e-3
timeStepper = tombo2
checkpointInterval = 0

[MESH]
# jet.box: x in [0, 3], y in [-0.8, 0.8], 60 x 32 x 1 elements (quasi-2D)
file = "jet.re2"

[FLUID PRESSURE]
residualTol = 1e-8

[FLUID VELOCITY]
boundaryTypeMap = udfDirichlet, zeroNeumann, zeroDirichletN/zeroNeumann
residualTol = 1e-10
rho = 1.0
viscosity = 5e-4

[CASEDATA]
# weak coflow through the inflow plane, feeds the entrainment. The droplet
# jet adds momentum but no gas, so the coflow must supply what the jet
# entrains or the outer flow reverses in this 1.6-wide box: scale u_co with
# J^(1/3) (0.05 at J 0.017, 0.11 at J 0.17, 0.25 at J 1.7)
u_co = 0.05
# droplet stream from the slot at x_nozzle: water-like density ratio
# rho_p/rho_f = 833 and a droplet whose stopping length (~40 slot widths)
# matches a 100 um water drop at 10 m/s from a 2 mm slot; phi_inj is the
# liquid volume fraction in the stream (a real water jet has 1)
u_jet = 10.0
w_slot = 0.04
x_nozzle = 0.5
# the sweep uses 5e-6 / 5e-5 / 5e-4 (J 0.017 / 0.17 / 1.7); the dense case
# needs dt = 2e-4 and advectionSubCyclingSteps = 2 (gas reaches u ~ 6)
phi_inj = 5e-6
dp = 2e-3
rhop = 833.0
parcels_per_step = 10
filter_width = 0.04
qtl = 0
report_interval = 100
# mode: 0 = droplet-driven jet (parcels), 1 = gas-only reference: the same
# kinematic momentum flux J = (rho_p/rho_f) phi_inj u_jet^2 w_slot as a
# top-hat velocity inlet of width w_slot on the x = 0 plane,
# u_slot = sqrt(J / w_slot)
inlet_jet = 0
# time average of the velocity field from t_avg on (field_avg.csv)
t_avg = 15.0
