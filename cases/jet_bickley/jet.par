userSections = CASEDATA

[GENERAL]
polynomialOrder = 5
stopAt = numSteps
numSteps = 8000
dt = 2.5e-3
timeStepper = tombo2
checkpointInterval = 0

[MESH]
# 40 x 32 x 1 elements on [0,2] x [-0.8,0.8] x [0,0.1]
file = "jet.re2"

[FLUID PRESSURE]
residualTol = 1e-8

[FLUID VELOCITY]
# 1: inflow (coflow u_co), 2: outflow, 3: symmetry
boundaryTypeMap = udfDirichlet, zeroNeumann, zeroDirichletN/zeroNeumann
residualTol = 1e-10
rho = 1.0
viscosity = 5e-4

[CASEDATA]
u_co = 0.05
# slot nozzle at x = x0, y = 0, full z
# Fast, very dilute stream: J = u_jet^2 w phi_inj (rho_l/rho_g) = 0.02 with
# a liquid mass flux of only J / u_jet, i.e. mass loading 0.01. The parcels
# stop within ~u_jet tau_p = 0.16 of the nozzle and then ride with the gas
# (~0.5), keeping only 0.5 % of J; with u_jet = 1 the liquid kept half of J.
# The slot is 2 w of the ppiclF cases so that the force density of the
# stopping stream (J / (w u_jet tau_p)) stays near the body-force blob's and
# the gas stays below the CFL limit at this dt.
u_jet = 10.0
w_slot = 0.04
x_nozzle = 0.5
phi_inj = 5e-6
# small droplets: tau_p = 0.028 (Stokes), 0.016 at Re_p = 10
dp = 0.0005
rhop = 1000.0
parcels_per_step = 10
filter_width = 0.04
qtl = 0
report_interval = 100
# 1: no parcels; the same momentum flux as a fixed Gaussian body force
#    (sigma = 2 w_slot) at the nozzle -> the nekRS-only reference
source_only = 0
